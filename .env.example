# ==============================================================================
# Live Subtitle Studio - Environment Configuration
# Copy this file to '.env' and customize it for your laptop/server setup:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFERENCE MODE CONFIGURATION
# ------------------------------------------------------------------------------
# Mode choices:
#   'shared' - Connect to a team server running the ASR/translation engine
#   'local'  - Run the ML models locally on the host laptop
ASR_MODE=shared

# URL of the shared inference server (used when ASR_MODE=shared)
# Replace with your team server's IP or hostname:
REMOTE_ASR_URL=ws://shared-ml-server.local:8765

# ------------------------------------------------------------------------------
# 2. LOCAL MODEL ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Default ASR model to load:
# Options: 'tiny.en', 'base', 'distil-small.en', 'small', 'medium', 'turbo'
MODEL_NAME=base

# ------------------------------------------------------------------------------
# 3. CPU PERFORMANCE TUNING
# ------------------------------------------------------------------------------
# Number of CPU threads dedicated to ONNX / faster-whisper inference
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
PYTHONUNBUFFERED=1

# HuggingFace cache directory for downloaded model weights
HF_HOME=./models
