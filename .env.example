# ==============================================================================
# Live Subtitle Studio - Environment Configuration
# Copy this file to '.env' and customize it for your laptop/server setup:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFERENCE MODE CONFIGURATION
# ------------------------------------------------------------------------------
# Mode choices:
#   'shared' - Connect to a team server running the ASR engine (no local model download)
#   'local'  - Run the ML model locally inside Docker or on the host laptop
ASR_MODE=shared

# URL of the shared inference server (used when ASR_MODE=shared)
# Replace with your team server's IP or hostname:
REMOTE_ASR_URL=ws://shared-ml-server.local:8765

# ------------------------------------------------------------------------------
# 2. LOCAL DOCKER ML ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Used when running local inference via:
#   docker compose --profile local-ml up -d

# Host port mapped to the container's WebSocket server
HOST_PORT=8765
CONTAINER_PORT=8765

# Path on the host machine where model weights are cached.
# Keep this outside Docker images so teammates only download once and don't rebuild images!
MODEL_DIR=./models

# Default ASR model to load:
# Options: 'tiny.en', 'base', 'distil-small.en', 'small', 'medium', 'turbo'
MODEL_NAME=base

# ------------------------------------------------------------------------------
# 3. CPU PERFORMANCE TUNING
# ------------------------------------------------------------------------------
# Number of CPU threads dedicated to OpenVINO / ONNX / faster-whisper inference
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
PYTHONUNBUFFERED=1

# HuggingFace cache directory inside the container (mapped to MODEL_DIR)
HF_HOME=/app/models
